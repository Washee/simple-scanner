{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
  
  "packageRules": [
    {
      "description": "Group all updates in github workflow",
      "matchFileNames": [
        ".github/workflows/docker-publish.yml",
        ".github/workflows/go.yml"
      ],
      "groupName": "Github Workflow"
    }
  ]
}
